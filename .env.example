# --- Core ---
WORKFORCE_ENV=development
WORKFORCE_API_KEY=change-me-to-a-long-random-secret
WORKFORCE_CORS_ORIGINS=http://localhost:5173

# --- Database (SQLite for local dev, PostgreSQL for hosted) ---
WORKFORCE_DATABASE_URL=sqlite:///./workforce.db
# WORKFORCE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/shahid_workforce

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Model providers (LiteLLM names) ---
MODEL_PRIMARY=
MODEL_FALLBACK=
# AGENT_MODEL_OVERRIDES={"research_agent":"gemini/gemini-2.0-flash"}
# MAX_TASK_COST_USD=1.00

# --- GitHub tools (fine-grained token, Contents read/write on this repo only) ---
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=shahid-boop/Shahid-Assistant-AI
GITHUB_ALLOWED_BRANCHES=feat/shahid-ai-workforce-foundation
